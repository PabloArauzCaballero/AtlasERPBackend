NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

DATABASE_URL=postgres://postgres:admin@localhost:5432/atlas_erp
DB_SSL=false
# Validar el certificado del servidor de base de datos. Dejar en true.
# En produccion no se admite false: declara la CA interna en DB_SSL_CA/DB_SSL_CA_FILE.
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----..."
# DB_SSL_CA_FILE=/etc/ssl/certs/atlas-postgres-ca.pem
DB_LOGGING=false
# Si es true y la base esta VACIA, el arranque trae el conjunto sembrado de la rama SEED_SOURCE_*.
# Si la base ya tiene datos no se toca nada: la carga es destructiva. Para resembrar a proposito
# esta `npm run db:seed:pull`.
STARTUP_SEEDS_ENABLED=true

# --- Origen de las semillas -------------------------------------------------------------------
# Los datos de semilla ya no viven en el repositorio: viven en una RAMA de PostgreSQL gestionado y
# se traen con `npm run db:seed:pull`. La rama ES el perfil, y como cada rama tiene su propio
# endpoint, apuntar a otra es cambiar SEED_SOURCE_HOST.
#   1. SEED_SOURCE_DATABASE_URL -> cadena completa; gana sobre todo lo demas.
#   2. SEED_SOURCE_HOST + _DB + _USER + _PASSWORD -> comodo cuando solo cambia la rama.
SEED_SOURCE_DATABASE_URL=
SEED_SOURCE_HOST=
SEED_SOURCE_PORT=5432
SEED_SOURCE_DB=atlas_erp
SEED_SOURCE_USER=
SEED_SOURCE_PASSWORD=
SEED_SOURCE_SSL=true

JWT_ACCESS_SECRET=change-this-access-secret-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
# Emisor y audiencia de la sesion de usuario. Los tokens de servicio usan los JWT_INTERNAL_*.
JWT_ACCESS_ISSUER=atlas-erp
JWT_ACCESS_AUDIENCE=atlas-erp-api
# Obligatorio en produccion y DISTINTO de JWT_ACCESS_SECRET: son dos planos de credencial.
JWT_INTERNAL_SECRET=change-this-internal-secret-with-at-least-32-characters
JWT_INTERNAL_ISSUER=atlas-internal
JWT_INTERNAL_AUDIENCE=atlas-ads

# Solo para pruebas locales/Postman. Nunca activar en production.
# Cuando está en true, JwtAuthGuard no exige Authorization: Bearer y crea un usuario local
# con los roles definidos abajo para poder recorrer endpoints protegidos.
AUTH_DISABLED_FOR_LOCAL_TESTING=false
AUTH_DISABLED_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_DISABLED_USER_EMAIL=postman.local@atlas.test
AUTH_DISABLED_ROLES=ADMIN,AUDITOR,COMMERCIAL_EXECUTIVE,COMMERCIAL_MANAGER,FINANCE,LEGAL,OPERATIONS,COLLECTIONS,MERCHANT_ADMIN,ACCOUNTANT,CFO,TREASURY,ADS_ADMIN_VIEWER,ADS_ADMIN_MANAGER,ADS_ADMIN_OPERATOR,ADS_FINANCE,ADS_AUDITOR,ADS_MODERATOR,ADS_COMPLIANCE_ADMIN,ADS_INVENTORY_MANAGER,ADS_OPS_MONITOR,ADS_AD_SERVER,ADS_EVENT_TRACKER

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BODY_LIMIT=1mb
LOG_LEVEL=info
# Log en columnas legibles con pino-pretty. Solo para desarrollo fuera de Docker: la imagen de
# produccion no lleva esa dependencia y encenderlo alli impide el arranque del proceso.

DEFAULT_MIN_MDR_RATE_PERCENT=2.5
DEFAULT_TAX_RATE_PERCENT=13

GLOBAL_ADS_ENABLED=true
ADS_DEFAULT_CURRENCY=BOB
ADS_EVENT_FRAUD_SCORE_MAX_BILLABLE=0.8
ADS_BILLING_TAX_RATE=0

# MailSender integrado al módulo publicitario. Use mock para desarrollo.
EMAIL_PROVIDER_MODE=mock
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_MAX_SEND_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=60000
EMAIL_WORKER_POLL_INTERVAL_MS=5000

OUTBOX_WORKER_ENABLED=true
# Pasada que marca OVERDUE las cuotas BNPL vencidas sin pago (corre dentro del API).
BNPL_OVERDUE_SWEEP_ENABLED=true
BNPL_OVERDUE_SWEEP_INTERVAL_MS=3600000
# Horas que un aviso de pago sin confirmar espera antes de ir a la cola de revisión de cobertura.
BNPL_PAYMENT_NOTICE_REVIEW_HOURS=72
OUTBOX_WORKER_POLL_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=25
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Entrega del outbox (P-03). El worker envía cada evento por HTTP POST firmado con HMAC-SHA256
# (cabecera x-atlas-signature: t=<unix>,v1=<hex>) y SÓLO un 2xx del receptor lo marca publicado.
# Sin OUTBOX_DELIVERY_URL los eventos quedan PENDING (el worker lo avisa en cada ciclo); nunca se
# marcan publicados por escribir un log. Si se declara la URL, el secreto es obligatorio (>= 32).
OUTBOX_DELIVERY_URL=
OUTBOX_DELIVERY_SIGNING_SECRET=
OUTBOX_DELIVERY_TIMEOUT_MS=10000
# El lease debe ser >= 2 x timeout: si caducara durante la llamada, otro worker tomaría el evento.
OUTBOX_LEASE_MS=60000
# Reintentos: backoff exponencial base * 2^(intento-1) con tope; agotados -> DEAD (replay autorizado).
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=3600000

# -----------------------------------------------------------------------------
# Trazas (OpenTelemetry -> OTLP -> Jaeger) — OPT-IN
# -----------------------------------------------------------------------------
# Con OTEL_ENABLED != true el backend arranca igual y no paga nada: ni exportador, ni parcheo de
# módulos, ni conexiones de fondo. Ver docs/observability/README.md.
OTEL_ENABLED=false

# Identidad del servicio en Jaeger. El nombre por defecto lo fija CADA PROCESO en su entrypoint
# (atlas-erp-api / atlas-erp-worker-outbox); esta variable lo sobrescribe, así que si se declara
# en un despliegue con los dos procesos hay que darle un valor DISTINTO a cada uno o el grafo de
# dependencias mostrará un solo nodo hablando consigo mismo.
OTEL_SERVICE_NAME=
OTEL_SERVICE_NAMESPACE=atlas
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=

# Destino de las trazas. Se admiten las dos formas:
#   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT  ruta COMPLETA  http://jaeger:4318/v1/traces
#   OTEL_EXPORTER_OTLP_ENDPOINT         base, se le añade /v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORT_TIMEOUT_MS=10000

# Muestreo basado en el padre: si quien llama (AtlasBackend, el portal) ya decidió muestrear una
# traza, se respeta; el ratio sólo gobierna las que NACEN aquí. En producción, 0.05-0.20.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

OTEL_PROPAGATORS=tracecontext,baggage
OTEL_DIAG_LOG_LEVEL=ERROR
