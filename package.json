    "db:migrate:audit": "tsx scripts/db/run-sql.ts src/database/migrations/20260709010000-create-business-action-logs.sql",
    "db:migrate:portal": "tsx scripts/db/run-sql.ts src/database/migrations/20260817120000-portal-merchant-scope-hardening.sql src/database/migrations/20260818040000-portal-identity-reference-is-opaque.sql src/database/migrations/20260825020000-merchant-plans-por-alcance-y-clics.sql src/database/migrations/20260826220000-catalogo-productos-facturables.sql",
    "db:seed:ads": "tsx scripts/db/run-sql.ts src/database/seeders/20260708204000-seed-atlas-ads-defaults.sql",
    "db:seed:billing-products": "tsx scripts/db/run-sql.ts src/database/seeders/20260826221000-seed-billing-products.sql",
    "db:seed:test-fixtures": "tsx scripts/db/run-sql.ts src/database/seeders/20260818000000-seed-portal-test-fixtures.sql",
    "db:seed:partners-dev": "tsx scripts/db/run-sql.ts src/database/seeders/20260821140000-seed-partners-desarrollo.sql",
    "db:seed:rating-policy": "tsx scripts/db/run-sql.ts src/database/seeders/20260816091000-seed-asfi-rating-policy.sql",
    "db:seed:demo": "tsx scripts/dev/seed-demo-operacion.ts",
    "dev:jwt": "tsx scripts/dev/create-test-jwt.ts",
    "smoke:accounting": "tsx scripts/smoke/accounting.smoke.ts",
    "smoke:ads": "tsx scripts/smoke/admin-ads.smoke.ts",
    "smoke:portal": "tsx scripts/smoke/portal.smoke.ts",
    "smoke:all": "node scripts/run-many.cjs smoke:b2b smoke:accounting smoke:ads smoke:portal smoke:batch",
    "worker:outbox": "node dist/src/workers/outbox/outbox.worker.js",
    "dev:worker:outbox": "tsx watch src/workers/outbox/outbox.worker.ts",
    "audit:use-cases": "tsx scripts/audit/use-cases.ts && prettier --write docs/audit/use-case-compliance-audit.json docs/audit/use-case-compliance-audit.md",
    "check:deploy": "node scripts/run-many.cjs type-check lint test test:e2e build",
    "clean:build-state": "node scripts/clean-build-state.cjs",
    "audit:frontend-contract": "node scripts/audit/frontend-backend-contract-audit.mjs",
    "smoke:batch": "tsx scripts/smoke/batch-endpoints.smoke.ts",
    "db:seed:accounting:official": "tsx scripts/db/import-official-seeds.ts",
    "db:seed:accounting:groups": "tsx scripts/db/run-sql.ts src/database/seeders/002_account_groups.sql",
    "db:seed:accounting:minimal": "tsx scripts/db/run-sql.ts src/database/seeders/001_reference_chart_of_accounts.sql",
    "db:metadata:export": "tsx scripts/db/export-entity-inventory.ts"
