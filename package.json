{
  "name": "atlas-integrated-backend",
  "version": "1.0.0",
  "description": "Backend integrado ATLAS: contabilidad, CRM/Ventas B2B y publicidad externa con NestJS, Sequelize, Zod, JWT y Pino.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "node scripts/clean-build-state.cjs && tsc -p tsconfig.build.json --pretty false --diagnostics",
    "start:prod": "node dist/src/main.js",
    "type-check": "tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "test": "node node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand --forceExit",
    "test:e2e": "node node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --forceExit",
