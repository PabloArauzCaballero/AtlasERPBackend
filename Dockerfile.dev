# syntax=docker/dockerfile:1.7
# Imagen de PRUEBAS del ERP, pensada para el VPS de testing (Ubuntu, Contabo).
#
# No sustituye a `Dockerfile`, que es la imagen de producción. Las diferencias son dos:
# `NODE_ENV=development` —para que Swagger y los logs sirvan de algo en un entorno de pruebas— y
# que aquí viajan `dist/scripts` y un cliente de PostgreSQL, porque en el VPS no hay una máquina de
# operador con Node 22 y `psql` a mano: migrar, sembrar y diagnosticar la base tiene que poder
# hacerse DENTRO del contenedor.
#
#   node dist/src/main.js                          la API
#   npm run db:migrate:prod                        migrar (la MISMA ruta que usa el despliegue)
#   node dist/scripts/db/seed-pull.js pull|status  traer o inspeccionar el conjunto sembrado
#
# ## Lo que NO trae, y por qué importa en un VPS
#
# **Las dependencias de desarrollo.** Se intentó al revés primero —el árbol completo, para poder
# invocar `tsx scripts/db/seed-pull.ts`— y costaba casi 400 MB para nada: `tsconfig.build.json`
# incluye `src/**` Y `scripts/**`, así que ese guion ya existe compilado en
# `dist/scripts/db/seed-pull.js` y corre con `node` a secas. La regla para no volver a equivocarse:
# si un guion se puede invocar como `node dist/scripts/X.js`, `tsx` no pinta nada en esta imagen.
#
# Construcción:
#   docker build -f Dockerfile.dev -t atlas-erp-backend:dev .

FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package*.json ./
# `--ignore-scripts`: ninguna dependencia de este proyecto compila nada nativo, y saltarse los
# postinstall es una superficie menos en una imagen que se reconstruye a menudo.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
# `type-check` antes de compilar, igual que la imagen de producción: en un VPS de pruebas una imagen
# que compila pero no tipa es exactamente la que hace perder una tarde.
RUN npm run type-check && npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

# `postgresql-client` es el añadido propio de esta imagen: cuando la base se comporta de forma rara
# en un VPS sin herramientas, tener un `psql` es la diferencia entre diagnosticar y adivinar.
#
# `apt` es OPCIONAL, y esa es la corrección. Esta misma línea tumbó el build de AtlasBackend dos
# veces con `exit code: 100`, y la causa no estaba en el Dockerfile: el demonio de Docker no tenía
# DNS. Se arregla en el host, pero una imagen no debería quedarse sin arrancar porque un espejo de
# Debian no conteste.
#
# Se comprobó qué hacía falta de verdad de los tres, y la respuesta es NINGUNO:
#
#   ca-certificates    Node trae su propio almacén de CA compilado dentro; verificado en la imagen
#                      hermana, un `fetch` a https devuelve 200 sin el paquete.
#   tini               lo aporta Docker con `init: true` en el compose, que no depende de
#                      descargar nada. Por eso ya NO es el ENTRYPOINT.
#   postgresql-client  diagnosticar la base desde dentro del contenedor, y sólo eso.
#
# `ForceIPv4` y los reintentos cubren los dos fallos de red más comunes de un VPS: IPv6 anunciado
# sin ruta, y un espejo que contesta a medias.
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/99-atlas \
  && (apt-get update \
      && apt-get install --no-install-recommends -y tini postgresql-client ca-certificates \
      && rm -rf /var/lib/apt/lists/* \
      || echo 'AVISO: no se pudieron instalar los paquetes opcionales; la imagen funciona igual')

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --ignore-scripts && npm cache clean --force

# `dist/` ENTERO, no sólo `dist/src`: `dist/scripts` es lo que hace innecesarias las dependencias de
# desarrollo. Y `package.json` conserva los scripts npm, así que `npm run db:migrate:prod` sigue
# funcionando tal cual.
COPY --from=build --chown=node:node /app/dist ./dist
# Los `.sql` los nombra `db:migrate:prod` POR RUTA. Sin copiarlos, la imagen arranca y la primera
# migración muere con «no such file», que es un fallo de EMPAQUETADO disfrazado de fallo de base.
COPY --chown=node:node src/database/migrations ./src/database/migrations
COPY --chown=node:node src/database/sql ./src/database/sql

USER node

ENV NODE_ENV=development \
    PORT=3007 \
    API_GLOBAL_PREFIX=api/v1
EXPOSE 3007

# Con NODE, no con `wget`: `node:22-bookworm-slim` NO trae wget, así que el healthcheck fallaba
# SIEMPRE —`wget: not found`, salida distinta de cero— y el contenedor quedaba marcado como
# `unhealthy` aunque la API respondiera perfectamente. En Coolify eso se ve como «degraded», que
# manda a buscar una avería que no existe. El intérprete de Node sí está, por definición.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3007)+'/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 

# Sin `ENTRYPOINT` con tini: ahora es un paquete opcional, y apuntar a un binario que puede no
# estar deja el contenedor sin arrancar —que es peor que no tener init—. Lo pone el compose con
# `init: true`, y hace el mismo trabajo.
# `dist/src/main.js`, no `dist/main.js`. `tsconfig.build.json` incluye `src/**` Y `scripts/**`, así
# que la raíz común que ve tsc es el repositorio y la salida conserva el prefijo `src/`. Con la ruta
# corta la imagen construye sin un error y muere al arrancar con MODULE_NOT_FOUND.
CMD ["node", "dist/src/main.js"]
