# syntax=docker/dockerfile:1.7
# Imagen de PRUEBAS del ERP, pensada para el VPS de testing (Ubuntu, Contabo).
#
# No sustituye a `Dockerfile`, que es la imagen de producción: allí se instala con `--omit=dev` y se
# copian sólo `dist/` y los `.sql`. Aquí viaja el árbol completo de dependencias, y es deliberado —
# en el VPS no hay una máquina de operador con Node 22 y `psql` a mano, así que todo lo que haya que
# ejecutar contra la base tiene que poder ejecutarse DENTRO del contenedor:
#
#   npm run db:migrate:prod   migrar (la ruta compilada, la misma que usa el despliegue)
#   npm run db:seed:pull      traer el conjunto sembrado desde la rama Neon   ← necesita `tsx`
#   npm run db:seed:status    ver qué publica la rama sin tocar nada          ← necesita `tsx`
#   npm run db:seed:demo      lo transaccional de demostración                ← necesita `tsx`
#
# Con `--omit=dev` los tres últimos fallan con «tsx: not found», que no se parece en nada a su causa.
#
# Construcción:
#   docker build -f Dockerfile.dev -t atlas-erp-backend:dev .

FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package*.json ./
# `--ignore-scripts`: ninguna dependencia de este proyecto necesita compilar nada nativo, y saltarse
# los postinstall es una superficie menos en una imagen que se reconstruye a menudo.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

# `postgresql-client` es el añadido propio de esta imagen: cuando la base se comporta de forma rara
# en un VPS sin herramientas, tener un `psql` es la diferencia entre diagnosticar y adivinar.
RUN apt-get update \
  && apt-get install --no-install-recommends -y tini postgresql-client ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

# `type-check` antes de compilar, igual que la imagen de producción: en un VPS de pruebas una imagen
# que compila pero no tipa es exactamente la que hace perder una tarde.
RUN npm run type-check && npm run build

RUN chown -R node:node /app/dist
USER node

ENV NODE_ENV=development \
    PORT=3007 \
    API_GLOBAL_PREFIX=api/v1
EXPOSE 3007

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3007}/api/v1/health" >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
# `dist/src/main.js`, no `dist/main.js`. `tsconfig.build.json` incluye `src/**` Y `scripts/**`, así
# que la raíz común que ve tsc es el repositorio y la salida conserva el prefijo `src/`. Con la ruta
# corta la imagen construye sin un error y muere al arrancar con MODULE_NOT_FOUND.
CMD ["node", "dist/src/main.js"]
