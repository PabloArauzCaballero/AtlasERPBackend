@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Ejecutivo comercial" as Sales
actor "Jefe comercial" as SalesMgr
actor "Legal/Compliance" as Legal
actor "Operaciones ATLAS" as Ops
actor "Finanzas/Contabilidad" as Finance
actor "Administrador comercio" as MerchantAdmin
actor "Core BNPL" as Core
actor "ERP / SIN" as ERP

rectangle "CRM/Ventas B2B ATLAS" {
  usecase "UC-01\nProspectar comercio" as UC01
  usecase "UC-02\nCalificar cuenta B2B" as UC02
  usecase "UC-03\nCrear oportunidad" as UC03
  usecase "UC-04\nGenerar propuesta" as UC04
  usecase "UC-05\nAprobar pricing especial" as UC05
  usecase "UC-06\nFirmar contrato B2B" as UC06
  usecase "UC-07\nOnboarding comercio" as UC07
  usecase "UC-08\nActivar comercio BNPL" as UC08
  usecase "UC-09\nRegistrar venta financiada" as UC09
  usecase "UC-10\nLiquidar MDR" as UC10
  usecase "UC-11\nFacturar B2B" as UC11
  usecase "UC-12\nRegistrar pago comercio" as UC12
  usecase "UC-13\nCubrir cuota impaga" as UC13
  usecase "UC-14\nRecuperar contra consumidor" as UC14
  usecase "UC-15\nConciliar operaciones" as UC15
  usecase "UC-16\nRenovar contrato" as UC16
}

Sales --> UC01
Sales --> UC02
Sales --> UC03
Sales --> UC04
Sales --> UC16
SalesMgr --> UC05
SalesMgr --> UC16
Legal --> UC06
Ops --> UC07
Ops --> UC08
MerchantAdmin --> UC07
MerchantAdmin --> UC09
Core --> UC09
Core --> UC13
Finance --> UC10
Finance --> UC11
Finance --> UC12
Finance --> UC13
Finance --> UC15
ERP --> UC11
ERP --> UC15

UC04 .> UC05 : <<include si excepción>>
UC06 .> UC07 : <<include>>
UC07 .> UC08 : <<include>>
UC09 .> UC10 : <<include>>
UC11 .> UC12 : <<extend>>
UC13 .> UC14 : <<include si ATLAS pagó>>
@enduml
